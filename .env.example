# Copiez ce fichier en « .env » et remplissez les valeurs.
#   cp .env.example .env
# Le fichier .env est ignoré par git et par le build Docker (ne pas le versionner).

# ─── OBLIGATOIRE ─────────────────────────────────────────────────────────────

# Secret partagé : chiffre les secrets (IMAP/SMTP/clé API) au repos et stabilise
# le cookie de session. Générez une valeur aléatoire (identique si plusieurs
# instances partagent la base) :
#   docker run --rm python:3.12-slim python -c "import secrets;print(secrets.token_hex(32))"
CV_AGENT_SECRET=

# Mot de passe du compte PostgreSQL « cvagent » (utilisé par docker-compose).
# IMPORTANT : utilisez UNIQUEMENT des lettres/chiffres — évitez @ : / ? # % &
# (ils devraient sinon être percent-encodés dans l'URL de connexion).
POSTGRES_PASSWORD=

# ─── OPTIONNEL ───────────────────────────────────────────────────────────────

# Clé API cloud OpenRouter (si vous utilisez le fournisseur LLM « openrouter »
# plutôt qu'Ollama local). Prioritaire sur la valeur stockée en base.
# OPENROUTER_API_KEY=

# Pose le drapeau Secure sur le cookie de session (derrière un reverse-proxy HTTPS).
# CV_AGENT_HTTPS_ONLY=1
