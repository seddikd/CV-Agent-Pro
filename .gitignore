# ─── Données & secrets — NE JAMAIS versionner ────────────────────────────────
# Base SQLite (données candidats + secrets DPAPI chiffrés, machine-liés).
state.db
state.db-*
*.sqlite
*.sqlite3
# Secret de session (généré au 1er lancement).
session.secret
# Fichier d'environnement Docker (secrets : CV_AGENT_SECRET, POSTGRES_PASSWORD).
.env
# CV et pièces jointes reçus (données personnelles candidats).
cv_pdfs/
# Journaux d'exécution.
logs/
# Export Excel généré.
output/
# Fichiers Outlook déposés pour l'import (PST/OST) — dossier runtime, données perso.
import/
*.pst
*.ost
# NB : config.yaml EST versionné — c'est le gabarit de premier lancement bundlé
# dans l'exe (valeurs d'exemple uniquement, jamais de vrais identifiants).

# ─── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ─── Build / packaging (PyInstaller, Inno Setup) ─────────────────────────────
build/
dist/
Output/
*.manifest
build_exe.log

# Support d'installation : on versionne les scripts + guide (Installer.ps1,
# GUIDE_INSTALLATION.md, LISEZ-MOI.txt, Prerequis/), PAS les binaires ni les
# copies de manuels (recopiés dans iso/Application et iso/Manuels au packaging).
iso/Application/
iso/Manuels/
iso/**/postgres-superuser-password.txt
iso/**/*.pdf
# Installeurs des prérequis téléchargés dans le support (PostgreSQL, Ollama).
iso/Prerequis/*.exe
# Manuels PDF régénérés par build_pdf.py (les .md sources, eux, sont versionnés).
MANUEL_*.pdf

# Supports de présentation (assets lourds : .pptx, .msi, .pdf, captures) — non versionnés.
Presentation/

# ─── IDE / OS ────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
